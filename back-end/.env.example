# Copy to `.env` (or to your shell profile) and adjust as needed. The
# defaults match `back-end/config/default.toml` so the unmodified
# settings just work for `cargo run -p hive-api -- serve`.

# Bind address. Keep on the loopback interface; the API has no auth
# and tools execute shell commands.
HIVE_BIND=127.0.0.1:8787

# Database URL.
#   sqlite://./hive.db?mode=rwc   — local dev (default)
#   postgres://user:pass@host/db  — for the cross-backend test runs
HIVE_DATABASE_URL=sqlite://./hive.db?mode=rwc

# Local Ollama base URL. Detected automatically at startup; this
# override is for non-default setups.
HIVE_OLLAMA_URL=http://localhost:11434

# Tracing filter. Same syntax as RUST_LOG. Examples:
#   info                     — info-level for the whole tree (default)
#   info,hive_runtime=debug  — debug detail just for the runtime crate
#   debug,hyper=warn         — broad debug, mute hyper noise
HIVE_LOG=info

# Set to any value to switch the log format to JSON (one structured
# event per line). Off by default; pretty-prints to the console.
# HIVE_LOG_JSON=1

# Where the master key + per-project workspaces live.
HIVE_DATA_DIR=~/.hive

# Sandbox preference. `docker` if Docker is available, `local` for the
# fallback chroot-style jail. Auto-detected when unset.
# HIVE_SANDBOX_PREFER=docker
