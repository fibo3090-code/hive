# Copy to `.env` (or set in your shell). The defaults match
# `back-end/config/default.toml` so the unmodified settings just work for
# `cargo run -p hive-api -- serve`.

# ── Wired today ──────────────────────────────────────────────────────────

# Tracing filter. Same syntax as RUST_LOG. Examples:
#   info                     — info-level for the whole tree (default)
#   info,hive_runtime=debug  — debug detail just for the runtime crate
#   debug,hyper=warn         — broad debug, mute hyper noise
HIVE_LOG=info

# Set to any non-empty value to switch the log format to JSON (one structured
# event per line). Off by default; pretty-prints to the console.
# HIVE_LOG_JSON=1

# Allowed CORS origins for the HTTP API, comma-separated. Override if your
# front-end is not at the dev defaults (http://127.0.0.1:8080 and :5173).
# Example: HIVE_CORS_ORIGINS=https://hive.lan,http://localhost:3000
# HIVE_CORS_ORIGINS=

# ── Not yet wired (planned in the W1-A5/A6 commit) ───────────────────────
# Today the database URL and the data directory come from
# `back-end/config/local.toml` (`[database] url = …`) and the hardcoded path
# `back-end/data/`. The env-var overrides below will start working once that
# patch lands; for now editing them has no effect.

# HIVE_BIND=127.0.0.1:8787
# HIVE_DATABASE_URL=sqlite://./data/hive.db?mode=rwc
# HIVE_DATA_DIR=~/.hive
# HIVE_OLLAMA_URL=http://localhost:11434
# HIVE_SANDBOX_PREFER=docker
