# Copy to `.env` (or set in your shell). The defaults below match
# `back-end/config/default.toml`, so an unmodified file already works for
# `cargo run -p hive-api -- serve`.

# ── Logging ──────────────────────────────────────────────────────────────

# Tracing filter. Same syntax as RUST_LOG. Examples:
#   info                     — info-level for the whole tree (default)
#   info,hive_runtime=debug  — debug detail just for the runtime crate
#   debug,hyper=warn         — broad debug, mute hyper noise
HIVE_LOG=info

# Set to any non-empty value to switch the log format to JSON (one
# structured event per line). Off by default; pretty-prints to the console.
# HIVE_LOG_JSON=1

# ── HTTP ─────────────────────────────────────────────────────────────────

# `host:port` to bind the HTTP API on. The default is loopback-only because
# the API has no auth and tools execute shell commands. Override only if
# HIVE sits behind a reverse proxy / Tailscale where you control access.
# HIVE_BIND=127.0.0.1:8787

# Allowed CORS origins for the HTTP API, comma-separated. Defaults to the
# Vite dev origins and their first fallback ports (:8080/:8081 and
# :5173/:5174 on both localhost and 127.0.0.1). Override if your front-end
# is served elsewhere.
# Example: HIVE_CORS_ORIGINS=https://hive.lan,http://localhost:3000
# HIVE_CORS_ORIGINS=

# ── State ────────────────────────────────────────────────────────────────

# Root for HIVE's local state — SQLite DB, per-project workspaces,
# attachments, and the master key all live under this directory. Defaults
# to `<repo>/back-end/data`. `~` is expanded against $HOME.
# HIVE_DATA_DIR=~/.hive

# Database connection URL. Overrides `[database] url` in
# `back-end/config/local.toml`. Falls back to a SQLite DB at
# `<data_dir>/hive.db` if neither is set. Supports `sqlite://`, `postgres://`,
# `mysql://`.
# HIVE_DATABASE_URL=sqlite://./data/hive.db?mode=rwc

# ── Integrations ─────────────────────────────────────────────────────────

# Base URL used by the boot-time "is Ollama up?" probe. The per-provider
# URL configured in the LLM Providers UI still wins for actual requests.
# HIVE_OLLAMA_URL=http://localhost:11434

# ── Not yet wired ────────────────────────────────────────────────────────
# Reserved for the upcoming Docker sandbox backend (W2/W3). Today
# `shell_exec` always uses the local sandbox with rlimit-based isolation.
# HIVE_SANDBOX_PREFER=docker
